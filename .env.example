# DATE CHECK 환경변수 — 값을 채워 .env.local 로 저장 (저장소에 올리지 않는다)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ADMIN_KEY=
# 리포트 봉투 암호 키 — 운영(Vercel production)에서는 꼭 넣는다. 없으면 점검이 멈춘다(대체값으로 만들지 않음)
REPORT_SECRET=
# 공공데이터포털 키 하나로 국세청·공정위·금융위·심평원
DATA_GO_KR_KEY=
# 사진 도용 확인(같은 사진 웹 검색) — Cloud Vision API 만 허용한 API 키
GOOGLE_VISION_API_KEY=
# 정밀 분석 가격 시험(쉼표로 여러 값, 비우면 기본 4900,7900,9900)
PRICE_VARIANTS=
# 배경·카드 그림 다시 만들 때만(scripts/gen-*.mjs) — 서비스 실행에는 필요 없음
OPENAI_API_KEY=
PORT=4040
